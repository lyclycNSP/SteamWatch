<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SteamWatch.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SteamWatch.App"
    xmlns:views="using:SteamWatch.App.Views"
    xmlns:controls="using:SteamWatch.App.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <NavigationView
        x:Name="RootNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        PaneDisplayMode="Auto" OpenPaneLength="200" CompactModeThresholdWidth="720" ExpandedModeThresholdWidth="1100" IsPaneOpen="True"
        SelectionChanged="RootNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem
                Content="游戏"
                Tag="Games">
                <NavigationViewItem.Icon>
                    <FontIcon
                        FontFamily="Segoe MDL2 Assets"
                        Glyph="&#xE7FC;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                Content="统计"
                Icon="Calendar"
                Tag="Statistics" />
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem
                x:Name="HelpNavigationItem"
                Content="帮助与关于"
                Icon="Help"
                Tag="Help" />
        </NavigationView.FooterMenuItems>

        <Grid Padding="24" SizeChanged="ContentGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                <TextBlock
                    x:Name="PageTitle"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="游戏" />
                <TextBlock
                    x:Name="PageSubtitle"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="今日 0 分钟 / 本周 0 分钟" />
                </StackPanel>
                <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent" VerticalAlignment="Top">
                    <AppBarButton x:Name="RefreshButton" Icon="Refresh" Label="刷新" Click="RefreshButton_Click" />
                    <AppBarButton x:Name="PauseMonitoringButton" Icon="Pause" Label="暂停限制" Click="PauseMonitoringButton_Click" />
                </CommandBar>
            </Grid>

            <views:GamePage x:Name="GameEditor" Grid.Row="2" />

            <views:StatisticsPage x:Name="StatisticsEditor" Grid.Row="2" Visibility="Collapsed" />

            <views:SettingsPage x:Name="SettingsEditor" Grid.Row="2" Visibility="Collapsed" />

            <views:HelpPage x:Name="HelpEditor" Grid.Row="2" Visibility="Collapsed" />
        </Grid>
    </NavigationView>
</Page>
