<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SteamWatch.App.Views.SettingsPage" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">


    <ScrollViewer x:Name="SettingsView" SizeChanged="SettingsView_SizeChanged" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">


        <StackPanel x:Name="SettingsContent" HorizontalAlignment="Left" MaxWidth="760" Spacing="12">


            <InfoBar x:Name="SettingsInfoBar" IsOpen="False" Severity="Informational"/>


            <TextBlock x:Name="SettingsSuccessMessage" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock x:Name="SettingsDraftNotice" Text="有未保存的修改 · 保存后生效" Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed"/>


            <StackPanel x:Name="SettingsRootPanel" Spacing="0">
                <Button Style="{StaticResource SettingsCategoryStyle}" Click="SettingsSectionButton_Click" Tag="General" AutomationProperties.Name="常规">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="18"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="常规" Style="{StaticResource SettingLabelStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="开机自启、关闭窗口和提醒声音 · 即时保存" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="12"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource SettingsCategoryStyle}" Click="SettingsSectionButton_Click" Tag="Reminder" AutomationProperties.Name="提醒和强退">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="18"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="提醒和强退" Style="{StaticResource SettingLabelStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="提醒阈值和倒计时 · 保存后生效" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="12"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource SettingsCategoryStyle}" Click="SettingsSectionButton_Click" Tag="Authentication" AutomationProperties.Name="认证保护">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="18"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="认证保护" Style="{StaticResource SettingLabelStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="为敏感操作设置密码 · 保存后生效" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="12"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource SettingsCategoryStyle}" Click="SettingsSectionButton_Click" Tag="Maintenance" AutomationProperties.Name="应用维护">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="18"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="应用维护" Style="{StaticResource SettingLabelStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="备份恢复、数据目录、诊断和移除应用" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="12"/>
                    </Grid>
                </Button>
            </StackPanel>
            <StackPanel x:Name="GeneralSettingsPanel" Spacing="12" Visibility="Collapsed">
                <Button Style="{StaticResource BackActionButtonStyle}" AutomationProperties.Name="返回设置" Click="SettingsBackButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="12"/>
                        <TextBlock Text="返回设置"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="常规" Style="{StaticResource SectionHeadingStyle}" TextWrapping="Wrap"/>
                <TextBlock Text="修改后立即保存；认证取消或写入失败时恢复原值。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="开机自启" Style="{StaticResource SettingLabelStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="登录 Windows 后启动 SteamWatch。移动绿色版目录后需重新设置。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <ToggleSwitch x:Name="StartWithWindowsSwitch" AutomationProperties.Name="开机自启" MinWidth="104" OffContent="关闭" OnContent="开启" Toggled="ImmediateSettingsSwitch_Toggled"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="关闭窗口时" Style="{StaticResource SettingLabelStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="选择退出应用，或留在托盘继续监控。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <ComboBox x:Name="CloseWindowActionComboBox" AutomationProperties.Name="关闭窗口时" Width="180" SelectedIndex="0" SelectionChanged="ImmediateSettingsComboBox_SelectionChanged">
                                <ComboBoxItem Content="最小化到托盘"/>
                                <ComboBoxItem Content="退出应用"/>
                            </ComboBox>
                        </Grid>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="提醒声音" Style="{StaticResource SettingLabelStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="默认允许声音提醒；单条规则仍可单独设置。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <ToggleSwitch x:Name="PlayReminderSoundsSwitch" AutomationProperties.Name="默认启用声音提醒" MinWidth="104" OffContent="关闭" OnContent="开启" Toggled="ImmediateSettingsSwitch_Toggled"/>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel x:Name="ReminderSettingsPanel" Spacing="8" Visibility="Collapsed">
                <Button Style="{StaticResource BackActionButtonStyle}" AutomationProperties.Name="返回设置" Click="SettingsBackButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="12"/>
                        <TextBlock Text="返回设置"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="提醒和强退" Style="{StaticResource SectionHeadingStyle}" TextWrapping="Wrap"/>
                <TextBlock Text="提醒阈值按已用实测时长占限额的比例计算。修改后保存生效。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="强退倒计时" Style="{StaticResource SettingLabelStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="5–600 秒；达到强退条件后用于保存进度。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <NumberBox x:Name="ForceCloseCountdownNumberBox" AutomationProperties.Name="强退倒计时秒数" Width="160" ValueChanged="SettingsDraftNumber_ValueChanged" LargeChange="30" Maximum="600" Minimum="5" SmallChange="5" SpinButtonPlacementMode="Compact" Value="60"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="提醒阈值" Style="{StaticResource SettingLabelStyle}" TextWrapping="Wrap"/>
                        <TextBlock Text="三个阈值必须递增，且均低于 100%。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <NumberBox Grid.Column="0" x:Name="FirstReminderThresholdNumberBox" Header="一级提醒 %" ValueChanged="SettingsDraftNumber_ValueChanged" Maximum="99" Minimum="1" SpinButtonPlacementMode="Compact" Value="70"/>
                            <NumberBox Grid.Column="1" x:Name="SecondReminderThresholdNumberBox" Header="二级提醒 %" ValueChanged="SettingsDraftNumber_ValueChanged" Maximum="99" Minimum="2" SpinButtonPlacementMode="Compact" Value="85"/>
                            <NumberBox Grid.Column="2" x:Name="FinalReminderThresholdNumberBox" Header="最终提醒 %" ValueChanged="SettingsDraftNumber_ValueChanged" Maximum="99" Minimum="3" SpinButtonPlacementMode="Compact" Value="95"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Padding="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveReminderSettingsButton" Style="{StaticResource PrimaryActionButtonStyle}" Click="SaveSettingsButton_Click" Content="保存设置"/>
                        <Button Content="放弃本次修改" Style="{StaticResource SecondaryActionButtonStyle}" Click="DiscardSettingsButton_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel x:Name="AuthenticationSettingsPanel" Spacing="12" Visibility="Collapsed">
                <Button Style="{StaticResource BackActionButtonStyle}" AutomationProperties.Name="返回设置" Click="SettingsBackButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="12"/>
                        <TextBlock Text="返回设置"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="认证保护" Style="{StaticResource SectionHeadingStyle}" TextWrapping="Wrap"/>
                <TextBlock Text="保护规则修改、设置保存、暂停与恢复限制、备份恢复和退出操作。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="敏感操作需要密码" Style="{StaticResource SettingLabelStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="关闭保护或更换密码时，仍需先验证当前密码。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <ToggleSwitch x:Name="RequireAuthenticationSwitch" AutomationProperties.Name="修改规则和退出时需要密码" MinWidth="104" OffContent="关闭" OnContent="开启" Toggled="SettingsDraftSwitch_Toggled"/>
                        </Grid>
                    </Grid>
                </Border>
                <StackPanel x:Name="AuthenticationFields" Spacing="12">
                    <TextBlock Text="已有密码时，两个输入框留空即可保留。新密码至少 4 位；关闭保护时无需填写新密码。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="AuthenticationPasswordBox" PasswordChanged="SettingsDraftPassword_Changed" Header="认证密码" PlaceholderText="设置认证密码"/>
                        <PasswordBox Grid.Column="1" x:Name="ConfirmAuthenticationPasswordBox" PasswordChanged="SettingsDraftPassword_Changed" Header="确认密码" PlaceholderText="再次输入新密码"/>
                    </Grid>
                </StackPanel>
                <Border Padding="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveAuthenticationSettingsButton" Style="{StaticResource PrimaryActionButtonStyle}" Click="SaveSettingsButton_Click" Content="保存设置"/>
                        <Button Content="放弃本次修改" Style="{StaticResource SecondaryActionButtonStyle}" Click="DiscardSettingsButton_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel x:Name="MaintenanceSettingsPanel" Spacing="12" Visibility="Collapsed">
                <Button Style="{StaticResource BackActionButtonStyle}" AutomationProperties.Name="返回设置" Click="SettingsBackButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="12"/>
                        <TextBlock Text="返回设置"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="应用维护" Style="{StaticResource SectionHeadingStyle}" TextWrapping="Wrap"/>
                <TextBlock Text="完整备份包含设置、认证配置、规则和时长；诊断包只包含脱敏运行摘要。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="数据备份" Style="{StaticResource SettingLabelStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="保存完整备份，便于迁移或恢复。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="导出数据备份" Style="{StaticResource SecondaryActionButtonStyle}" Click="ExportBackupButton_Click"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="恢复数据" Style="{StaticResource SettingLabelStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="将替换当前数据；恢复前会保留备份。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="恢复数据备份" Style="{StaticResource SecondaryActionButtonStyle}" Click="RestoreBackupButton_Click"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="数据目录" Style="{StaticResource SettingLabelStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="查看本机数据和错误日志。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="打开数据和诊断目录" Style="{StaticResource SecondaryActionButtonStyle}" Click="OpenDataFolderButton_Click"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="问题诊断" Style="{StaticResource SettingLabelStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="不包含密码配置、账号、游戏名称或个人路径。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="导出诊断包" Style="{StaticResource SecondaryActionButtonStyle}" Click="ExportDiagnosticsButton_Click"/>
                        </Grid>
                    </Grid>
                </Border>
                <StackPanel Spacing="12" Margin="0,16,0,0">
                    <TextBlock Text="移除应用" Style="{StaticResource SectionHeadingStyle}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PortableRemovalHint" Text="绿色版无需卸载。先退出程序，再移除解压目录；保留记录前请先备份 data。" Style="{StaticResource HelpBodyStyle}"/>
                    <Button Content="卸载 SteamWatch" Style="{StaticResource SecondaryActionButtonStyle}" Click="UninstallButton_Click" x:Name="UninstallButton"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
