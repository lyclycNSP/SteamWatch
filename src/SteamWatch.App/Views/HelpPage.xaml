<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SteamWatch.App.Views.HelpPage" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <ScrollViewer x:Name="HelpView" SizeChanged="HelpView_SizeChanged" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="HelpContent" HorizontalAlignment="Left" MaxWidth="760" Spacing="24">
            <StackPanel Spacing="12">
                <TextBlock Text="常用操作" Style="{StaticResource SectionHeadingStyle}"/>
                <TextBlock Text="通知不出现时先检查 Windows 勿扰模式；敏感操作保护可在设置中开启。" Style="{StaticResource HelpBodyStyle}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="提醒设置" Tag="Reminder" Style="{StaticResource SecondaryActionButtonStyle}" Click="SettingsLink_Click"/>
                    <Button Content="认证保护" Tag="Authentication" Style="{StaticResource SecondaryActionButtonStyle}" Click="SettingsLink_Click"/>
                    <Button Content="备份和诊断" Tag="Maintenance" Style="{StaticResource SecondaryActionButtonStyle}" Click="SettingsLink_Click"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock Text="使用指南" Style="{StaticResource SectionHeadingStyle}"/>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="运行数据和离线补记" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBlock Text="安装版数据位于 %LOCALAPPDATA%\SteamWatch；绿色版数据位于解压根目录 data。搬迁绿色版时复制整个目录，升级前先退出并备份。" Style="{StaticResource HelpBodyStyle}" TextWrapping="Wrap"/>
                        <TextBlock Text="实测时长保留秒以下精度，按日期拆分，界面显示完整分钟。Steam 差值是估算补记，只在统计展示，不计入限额。" Style="{StaticResource HelpBodyStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="通知提醒和勿扰模式" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBlock Text="全屏游戏可能触发 Windows 勿扰模式；系统通知、应用弹窗和声音的可见性需按实际游戏验证。" Style="{StaticResource HelpBodyStyle}" TextWrapping="Wrap"/>
                        <TextBlock Text="按 Win + I，进入“系统 → 通知”，检查勿扰模式及玩游戏、全屏时的自动开启条件。" Style="{StaticResource HelpBodyStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="托盘和退出" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBlock Text="关闭窗口可选择最小化到托盘或退出应用。托盘菜单提供打开窗口、暂停或恢复限制、进入设置和退出。" Style="{StaticResource HelpBodyStyle}" TextWrapping="Wrap"/>
                        <TextBlock Text="暂停限制仍继续计时；开启认证保护后，暂停、恢复和退出仍需验证密码。" Style="{StaticResource HelpBodyStyle}" TextWrapping="Wrap"/>
                        <TextBlock Text="关闭到托盘会保留设置草稿。真正退出前可保存、不保存或继续编辑；认证取消或保存失败时继续运行，未保存草稿仍保留。" Style="{StaticResource HelpBodyStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="游戏限额" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBlock Text="游戏页顶部设置全部游戏的每日或每周总限额；双击游戏或使用右键菜单可设置单游戏规则，两类规则同时生效。" Style="{StaticResource HelpBodyStyle}" TextWrapping="Wrap"/>
                        <TextBlock Text="仅提醒会通知；强制退出会在倒计时后尝试关闭目标游戏。限额只采用实测时长，修改或删除规则受认证保护。" Style="{StaticResource HelpBodyStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="认证保护" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBlock Text="已有密码时留空保留；设置新密码需要两次一致，关闭或修改保护需先验证当前密码。密码以带盐哈希保存。" Style="{StaticResource HelpBodyStyle}" TextWrapping="Wrap"/>
                        <TextBlock Text="认证用于减少应用内绕过，不能阻止任务管理器结束进程、删除本地数据或系统卸载。请妥善保管包含认证配置的完整备份。" Style="{StaticResource HelpBodyStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0" Padding="0,0,0,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="关于 SteamWatch" Style="{StaticResource SectionHeadingStyle}"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource HelpBodyStyle}"/>
                    <TextBlock x:Name="ModeText" Style="{StaticResource HelpBodyStyle}"/>
                    <TextBlock Text="本地、离线的 Steam 游戏时长管理工具。" Style="{StaticResource SecondaryTextStyle}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
