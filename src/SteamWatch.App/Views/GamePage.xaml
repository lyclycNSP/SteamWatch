<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SteamWatch.App.Views.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SteamWatch.App">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="BudgetGrid" ColumnSpacing="0" Padding="0,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border x:Name="DailyBudgetCard" Grid.Column="0" Style="{StaticResource SummaryStripItemStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="全部游戏 · 每日总限额" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DailyBudgetUsage" Text="正在读取…" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <ProgressBar x:Name="DailyBudgetProgress" Maximum="100" Height="4" />
                            <TextBlock x:Name="DailyBudgetDetail" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                            <HyperlinkButton Content="设置总限额" IsEnabled="{x:Bind IsRuleEditorAvailable, Mode=OneWay}" Click="EditDailyGlobalLimit_Click" Padding="0,4" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="WeeklyBudgetCard" Grid.Column="1" Style="{StaticResource SummaryStripItemStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="全部游戏 · 每周总限额" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="WeeklyBudgetUsage" Text="正在读取…" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <ProgressBar x:Name="WeeklyBudgetProgress" Maximum="100" Height="4" />
                            <TextBlock x:Name="WeeklyBudgetDetail" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                            <HyperlinkButton Content="编辑每周限额" IsEnabled="{x:Bind IsRuleEditorAvailable, Mode=OneWay}" Click="EditWeeklyGlobalLimit_Click" Padding="0,4" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ForceCloseCard" Grid.Column="2" Style="{StaticResource SummaryStripItemStyle}" BorderThickness="0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="最早强退" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Name="EarliestForceCloseText" Text="正在读取…" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="ForceCloseHint" Text="全部游戏与单游戏规则同时生效" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock x:Name="StatusFeedback" Grid.Row="1" Text="{x:Bind StatusMessage, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" MaxLines="2" ToolTipService.ToolTip="{x:Bind StatusMessage, Mode=OneWay}" />
                <Grid x:Name="LibraryPanel" Grid.Row="2" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="GameSearchTextBox" PlaceholderText="搜索游戏名称或 AppID" TextChanged="GameSearchTextBox_TextChanged" />
                        <CheckBox Grid.Column="1" x:Name="RunningOnlyCheckBox" Content="运行中" Checked="GameFilter_Changed" Unchecked="GameFilter_Changed" />
                        <ComboBox Grid.Column="2" x:Name="CategoryFilterComboBox" AutomationProperties.Name="按类别筛选" SelectedIndex="0" SelectionChanged="CategoryFilter_SelectionChanged">
                            <ComboBoxItem Content="全部类别" /><ComboBoxItem Content="游戏" /><ComboBoxItem Content="运行库／工具" /><ComboBoxItem Content="未知" />
                        </ComboBox>
                    </Grid>
                    <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="84" /><ColumnDefinition Width="84" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                        <TextBlock Text="游戏" /><TextBlock Grid.Column="1" Text="状态" /><TextBlock Grid.Column="2" Text="今日实测" /><TextBlock Grid.Column="3" Text="本周实测" /><TextBlock Grid.Column="4" Text="单游戏限额与策略" />
                    </Grid>
                    <ListView x:Name="GamesListView" Grid.Row="2" ItemsSource="{x:Bind GameRows}" SelectionChanged="GamesListView_SelectionChanged" HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:GameRowViewModel">
                                <Grid Padding="0,6" ColumnSpacing="12" Background="Transparent" DoubleTapped="GameRow_DoubleTapped" RightTapped="GameRow_RightTapped">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="设置限额" Tag="{x:Bind}" Click="SetLimitForSelectedButton_Click"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Clock" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                            <MenuFlyoutItem Text="游戏详情" Tag="{x:Bind}" Click="GameDetails_Click"><MenuFlyoutItem.Icon><SymbolIcon Symbol="View" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="强退策略" Tag="{x:Bind}" Click="ForceClosePolicyButton_Click"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Stop" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                            <MenuFlyoutItem Text="设置选中项分类" Tag="{x:Bind}" Click="SetGameCategoryButton_Click"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Edit" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="84" /><ColumnDefinition Width="84" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Image Width="36" Height="36" Source="{x:Bind IconSource, Mode=OneWay}" />
                                        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" /><TextBlock Text="{x:Bind AppIdText}" Style="{StaticResource SecondaryTextStyle}" /></StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Status, Mode=OneWay}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind TodayText, Mode=OneWay}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind WeekText, Mode=OneWay}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind RuleText, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="24" ToolTipService.ToolTip="{x:Bind RuleText, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <CommandBar x:Name="GameActionsCommandBar" Grid.Row="3" DefaultLabelPosition="Right" Background="Transparent">
                        <CommandBar.Content><CheckBox x:Name="RulesOnlyCheckBox" Content="已设单游戏规则" Checked="GameFilter_Changed" Unchecked="GameFilter_Changed" /></CommandBar.Content>
                        <AppBarButton x:Name="SetLimitForSelectedButton" IsEnabled="{x:Bind IsRuleEditorAvailable, Mode=OneWay}" Icon="Clock" Label="设置限额" Click="SetLimitForSelectedButton_Click" />
                        <AppBarButton Icon="View" Label="游戏详情" Click="GameDetails_Click" />
                        <CommandBar.SecondaryCommands>
                            <AppBarButton x:Name="ForceClosePolicyButton" Icon="Stop" Label="强退策略" Click="ForceClosePolicyButton_Click" />
                            <AppBarButton Label="设置选中项分类" Icon="Edit" Click="SetGameCategoryButton_Click" />
                        </CommandBar.SecondaryCommands>
                    </CommandBar>
                    <TextBlock x:Name="EmptyGamesText" Grid.Row="2" Text="没有匹配的条目。可修改搜索或筛选条件。" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" />
                </Grid>
                <TextBlock Grid.Row="3" Text="未设置单游戏限额的条目仍受全部游戏总限额约束。估算不参与限额。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
            </Grid>
</UserControl>
