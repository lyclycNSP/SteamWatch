<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>SteamWatch.Installer</RootNamespace>
    <AssemblyName>SteamWatch.InstallationHelper</AssemblyName>
    <ApplicationIcon>..\SteamWatch.App\Assets\AppIcon.ico</ApplicationIcon>
    <Win32Icon>..\SteamWatch.App\Assets\AppIcon.ico</Win32Icon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="DirectoryUpgrade.cs" />
    <Compile Include="..\SteamWatch.Infrastructure\Runtime\UpgradeExitProtocol.cs" Link="UpgradeExitProtocol.cs" />
    <Content Include="..\SteamWatch.App\Assets\AppIcon.ico" Link="AppIcon.ico" />
  </ItemGroup>

</Project>
